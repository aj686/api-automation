# --- API Automation -------------------------------------------------------
# Imported Postman collections and temporary Postman environment files.
# These hold real credentials at runtime (plan section 6).
# storage/app/private/.gitignore already ignores its own contents; this line
# is the explicit, visible version of the same rule.
/storage/app/private/*

# Raw Postman CLI JSON reports. Deleted after parsing, never committed.
/postman-cli-reports/

# Local SQLite file from the Laravel scaffold. This project uses MySQL.
/database/*.sqlite
/database/*.sqlite-journal

# Windows "mark of the web" streams, saved as files over the WSL share.
*:Zone.Identifier
