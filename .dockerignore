# Never bake secrets or local state into the image.
.env
.env.*
!.env.example
*.pem
*.key
*.sql
*.sql.gz
*.dump

.git
.claude
node_modules
vendor
public/build
public/hot
public/storage
postman-cli-reports

storage/app/private/*
!storage/app/private/.gitignore
storage/app/public/*
!storage/app/public/.gitignore
storage/framework/cache/data/*
storage/framework/sessions/*
storage/framework/views/*
storage/logs/*
bootstrap/cache/*.php

.phpunit.cache
.phpunit.result.cache
docs/screenshots
*:Zone.Identifier
