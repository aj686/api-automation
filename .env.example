APP_NAME="API Automation"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://api-automation.local

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL lives in the docker-webstack stack. "mysql" is the service/container
# name on the docker_webstack network, so it resolves from php8.3.fpm and from
# the api-automation-worker container. From the WSL host use 127.0.0.1:3306.
# Create the databases and this user first: see docs/setup-mysql.md
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=api_automation
DB_USERNAME=api_automation
DB_PASSWORD=YOUR_PASSWORD

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Runs are queued and executed by the api-automation-worker container.
# Database driver on purpose: no Redis queue (plan section 2).
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

# Redis is present in the stack but this application does not use it.
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.invalid"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# --- API Automation -------------------------------------------------------
# Postman CLI executable. Resolved from this variable only, never from user
# input (plan section 6). It exists only inside the worker container.
POSTMAN_CLI_PATH=postman

# Bearer token for /api/v1 (used by n8n). Empty = the API is disabled.
# Generate with: php artisan automation:token   (implemented in phase 12)
AUTOMATION_API_TOKEN=

# Wall-clock limit for a single run, in seconds. The queue worker's --timeout
# must stay larger than this (plan section 11).
AUTOMATION_RUN_TIMEOUT_SECONDS=300
